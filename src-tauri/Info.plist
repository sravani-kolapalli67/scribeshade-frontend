<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Register scribeshade:// as a handled URL scheme so macOS routes
       deep links back to the installed .app bundle. Without this entry
       the OS has no record of the scheme and the browser shows
       "Failed to launch 'scribeshade://'" in both the address bar and the
       browser console. This entry is merged into the generated Info.plist
       at bundle time by Tauri (bundle.macOS.infoPlist in tauri.conf.json).
       Note: scheme registration only takes effect in a *signed & installed*
       .app — it is intentionally unavailable in `tauri dev` mode. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>scribeshade</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>scribeshade</string>
      </array>
    </dict>
  </array>

  <!-- Hide this app from the Dock, Cmd+Tab switcher, and menu bar.
       ScribeShade is a screen overlay — it should behave like a system utility,
       not a regular foreground app. setActivationPolicy("regular") in
       open_main_dashboard can temporarily override this when the full dashboard
       window is open; show_launcher_widget restores "accessory" on close. -->
  <key>LSUIElement</key>
  <true/>

  <!-- Required for getDisplayMedia audio — WKWebView checks this key before
       offering the "Include audio" / "Share tab audio" toggle in the macOS
       screen-share picker. Without it the toggle is hidden and the stream
       always has zero audio tracks. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>ScribeShade needs microphone access to transcribe the conversation in real time.</string>

  <!-- Required for getDisplayMedia video on macOS 14 + -->
  <key>NSScreenCaptureUsageDescription</key>
  <string>ScribeShade needs screen capture access to display and analyze the shared content.</string>

</dict>
</plist>
