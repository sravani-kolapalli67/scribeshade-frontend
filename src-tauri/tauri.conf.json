{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScribeShade",
  "version": "2.0.0",
  "identifier": "com.hiddenmindsolutions.scribeshade-frontend",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "mini",
        "title": "ScribeShade Floating Screen",
        "url": "floating.html",
        "transparent": true,
        "decorations": false,
        "width": 700,
        "height": 360,
        "visible": false,
        "center": true,
        "resizable": false,
        "minimizable": true,
        "maximizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true
      },
      {
        "label": "launcher",
        "title": "ScribeShade",
        "url": "launcher.html",
        "width": 460,
        "height": 260,
        "transparent": true,
        "shadow": false,
        "decorations": false,
        "visible": false,
        "center": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm",
      "dmg",
      "msi",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "scribeshade"
        ]
      }
    },
    "fs": {
      "requireLiteralLeadingDot": true
    },
    "updater": {
      "endpoints": [
        "https://test.backend.scribeshade.org/api/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3MjU2MjVCQkNGRjlENzEKUldSeG5mKzhXMklsTnkyTU5yZEhMLy9sODRGSDMraXJHaGlGM2ZTNllENnZlYWMza3FtSGRiL0kK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
