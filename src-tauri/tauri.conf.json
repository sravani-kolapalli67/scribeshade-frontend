{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScribeShade",
  "version": "0.1.0",
  "identifier": "com.hiddenmindsolutions.scribeshade-frontend",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "mini",
        "title": "ScribeShade Floating Screen",
        "url": "floating.html",
        "transparent": true,
        "decorations": false,
        "visible": false,
        "center": true,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "contentProtected": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["craftvita"]
      }
    },
    "fs": {
      "requireLiteralLeadingDot": true
    }
  }
}
