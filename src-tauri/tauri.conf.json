{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "ScribeShade",
    "version": "2.1.55",
    "identifier": "com.hiddenmindsolutions.scribeshade-frontend",
    "build": {
          "beforeDevCommand": "pnpm dev",
          "devUrl": "http://localhost:1420",
          "beforeBuildCommand": "pnpm build",
          "frontendDist": "../dist"
    },
    "app": {
          "macOSPrivateApi": true,
          "windows": [],
          "security": {
                  "csp": null
          }
    },
    "bundle": {
          "active": true,
          "targets": [
                  "app",
                  "dmg",
                  "msi",
                  "nsis"
          ],
          "createUpdaterArtifacts": true,
          "icon": [
                  "icons/icon.ico",
                  "icons/icon.icns",
                  "icons/32x32.png",
                  "icons/128x128.png",
                  "icons/128x128@2x.png"
          ],
          "macOS": {
                  "infoPlist": "Info.plist",
                  "entitlements": "entitlements.plist",
                  "minimumSystemVersion": "13.0"
          }
    },
    "plugins": {
          "deep-link": {
                  "desktop": {
                            "schemes": [
                                        "scribeshade"
                            ]
                  }
          },
          "fs": {
                  "requireLiteralLeadingDot": true
          },
          "updater": {
                  "endpoints": [
                            "https://api.scribeshade.org/tauri-updates/latest.json"
                  ],
                  "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBQzIwNTI4RDFCQzk3MTUKUldRVmw3elJLQVhDbXVUQ0Jkbzl6dzJ0NENuWS8xU0xoNkUvaTJncHZSd1Q3T3E5U1hXdEhSbmsK",
                  "windows": {
                            "installMode": "passive"
                  }
          }
    }
}
